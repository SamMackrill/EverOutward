{
  "name": "ever-outward",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --watch-path=server server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "catalogue:import": "node scripts/import-catalogue.mjs",
    "deploy": "node scripts/publish.mjs",
    "test:browser": "node tests/browser.mjs && node tests/photo-browser.mjs && node tests/carousel-browser.mjs && node tests/homes-browser.mjs && node tests/publish-browser.mjs && node tests/distance-review-browser.mjs && node tests/timeline-browser.mjs",
    "icons": "node scripts/icons.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.mjs\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\"",
    "routes:refresh": "node scripts/refresh-routes.mjs",
    "homes:list": "node scripts/list-homes.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
