# The local server grants owner access automatically; no sign-in is needed.
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
# Set to 1 for a temporary journal copy; disables publishing from the workspace.
TEMPORARY_PREVIEW=0
# HERENOW_API_KEY is read from the environment or ~/.herenow/credentials.
# Never put credentials in a VITE_ variable.
